# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# Environment
ENVIRONMENT=staging
DEBUG=false

# Model Settings
MODEL_PATH=/app/models
MODEL_NAME=image_classifier
MODEL_VERSION=staging

# Data Paths
DATA_DIR=/app/data
RAW_DATA_DIR=/app/data/raw
PROCESSED_DATA_DIR=/app/data/processed

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=image_classification_staging

# Authentication
API_KEY=${STAGING_API_KEY}
JWT_SECRET_KEY=${STAGING_JWT_SECRET}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/api.log

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS
ALLOWED_ORIGINS=https://staging.example.com

# Database
DATABASE_URL=${STAGING_DATABASE_URL}

# AWS S3
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_S3_BUCKET=example-staging-models
AWS_REGION=us-east-1

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_ENABLED=true

# GPU Settings
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_FRACTION=0.8
