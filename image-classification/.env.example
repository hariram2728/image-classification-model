# ===========================================
# Environment Configuration Template
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets to version control
# ===========================================

# ===========================================
# API Configuration
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (MUST be false in production!)
DEBUG=false

# ===========================================
# Model Settings
# ===========================================
MODEL_PATH=./models/best_model.pth
MODEL_NAME=image_classifier
DEVICE=cuda

# ===========================================
# Authentication - CRITICAL FOR PRODUCTION
# ===========================================
# Generate a strong API key for production use
# Example: openssl rand -hex 32
# WARNING: Never use empty or default values in production
API_KEY=

# JWT Secret - MUST be at least 32 characters
# Generate with: openssl rand -hex 32
# WARNING: Application will fail to start in production without this
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256

# ===========================================
# Security Settings
# ===========================================
# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=10

# Enable HTTPS redirect in production
ENABLE_HTTPS_REDIRECT=true

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins
# SECURITY: NEVER use '*' in production when using credentials
# Leave empty to block all cross-origin requests
ALLOWED_ORIGINS=

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================================
# Monitoring
# ===========================================
PROMETHEUS_ENABLED=true
METRICS_ENABLED=true

# ===========================================
# DEVELOPMENT ONLY SETTINGS BELOW
# Do not use these in production!
# ===========================================

# Development database (for experiment tracking)
DATABASE_URL=postgresql://user:password@localhost:5432/mlflow

# MLflow (development)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=image_classification

# Data Paths (development)
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# GPU Settings (development)
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_FRACTION=0.8

# AWS S3 (for model storage) - Configure in production via secrets manager
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
